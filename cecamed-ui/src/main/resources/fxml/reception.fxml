<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="18.0" styleClass="content-pane" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cecamed.ui.controller.ReceptionController">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="4.0">
            <Label styleClass="page-title" text="Recepci?n y Sala de Espera"/>
            <Label styleClass="page-subtitle" text="Control ?gil de flujo de pacientes, check-in y tiempos de espera en tiempo real"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#handleRefresh" styleClass="ghost-button" text="Actualizar">
                <graphic>
                    <FontIcon iconLiteral="feather-refresh-cw" iconSize="15"/>
                </graphic>
            </Button>

            <Button onAction="#handleNewAppointment" styleClass="primary-button" text="Cita R?pida">
                <graphic>
                    <FontIcon iconColor="WHITE" iconLiteral="feather-calendar" iconSize="16"/>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Metrics Row -->
    <HBox fx:id="statCardsContainer" spacing="16.0">
        <!-- Tarjetas din?micas de StatCard -->
    </HBox>

    <!-- Main Working Area: Split between Today's Schedule and Live Waiting Room -->
    <SplitPane dividerPositions="0.60" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">

        <!-- Left: Tabla Citas del D?a -->
        <VBox spacing="12.0" styleClass="cecamed-card">
            <!-- Search & Filter Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <FontIcon iconColor="#0288D1" iconLiteral="feather-list" iconSize="18"/>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Citas M?dicas de Hoy"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <StackPane alignment="CENTER_RIGHT">
                    <TextField fx:id="searchField" prefWidth="210.0" promptText="Buscar paciente o DNI..." style="-fx-padding: 6 12 6 28;"/>
                    <FontIcon iconColor="#94A3B8" iconLiteral="feather-search" iconSize="14" StackPane.alignment="CENTER_LEFT">
                        <StackPane.margin>
                            <Insets left="8.0"/>
                        </StackPane.margin>
                    </FontIcon>
                </StackPane>

                <ComboBox fx:id="statusFilterComboBox" prefWidth="130.0"/>

                <ProgressIndicator fx:id="loadingIndicator" maxHeight="18.0" maxWidth="18.0" visible="false"/>
                <Label fx:id="appointmentsCountLabel" styleClass="page-subtitle" style="-fx-font-weight: bold;" text="Citas: 0"/>
            </HBox>

            <Separator/>

            <!-- Table -->
            <TableView fx:id="todayAppointmentsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTime" minWidth="65.0" prefWidth="75.0" text="Hora"/>
                    <TableColumn fx:id="colPatient" minWidth="150.0" prefWidth="180.0" text="Paciente"/>
                    <TableColumn fx:id="colPhone" minWidth="85.0" prefWidth="95.0" text="Tel?fono"/>
                    <TableColumn fx:id="colReason" minWidth="120.0" prefWidth="140.0" text="Motivo"/>
                    <TableColumn fx:id="colStatus" minWidth="110.0" prefWidth="120.0" text="Estado"/>
                    <TableColumn fx:id="colActions" minWidth="170.0" prefWidth="185.0" sortable="false" text="Acciones R?pidas"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Monitor de Sala de Espera Activa -->
        <VBox spacing="12.0" styleClass="cecamed-card">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <FontIcon iconColor="#D97706" iconLiteral="feather-clock" iconSize="18"/>
                <VBox>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Monitor de Sala de Espera"/>
                    <Label fx:id="waitingCountLabel" styleClass="page-subtitle" style="-fx-font-size: 11px;" text="Pacientes en espera: 0"/>
                </VBox>
            </HBox>

            <Separator/>

            <TableView fx:id="waitingRoomTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colWaitPatient" minWidth="120.0" prefWidth="140.0" text="Paciente"/>
                    <TableColumn fx:id="colWaitAppTime" minWidth="60.0" prefWidth="70.0" text="Cita"/>
                    <TableColumn fx:id="colWaitArrivalTime" minWidth="65.0" prefWidth="75.0" text="Llegada"/>
                    <TableColumn fx:id="colWaitElapsedTime" minWidth="85.0" prefWidth="95.0" text="Tiempo Espera"/>
                    <TableColumn fx:id="colWaitActions" minWidth="115.0" prefWidth="125.0" sortable="false" text="Consultorio"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </SplitPane>

</VBox>
