<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cecamed.ui.controller.LoginController">

    <!-- Top Right Theme Switcher -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets top="20.0" right="24.0" bottom="0.0" left="24.0"/>
            </padding>
            <Button fx:controller="com.cecamed.ui.controller.LoginController" fx:id="toggleThemeButton"
                    onAction="#handleToggleTheme" styleClass="ghost-button">
                <graphic>
                    <FontIcon fx:id="toggleThemeIcon" iconLiteral="feather-moon" iconSize="20"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- Center Login Card -->
    <center>
        <VBox alignment="CENTER" maxWidth="460.0" spacing="24.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="32.0" left="24.0" right="24.0" top="10.0"/>
            </padding>

            <!-- Card Box -->
            <VBox spacing="20.0" styleClass="cecamed-card">
                <padding>
                    <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
                </padding>

                <!-- Brand Header -->
                <VBox alignment="CENTER" spacing="8.0">
                    <HBox alignment="CENTER" spacing="10.0">
                        <FontIcon iconColor="#D32F2F" iconLiteral="feather-activity" iconSize="34"/>
                        <Label styleClass="brand-title" style="-fx-font-size: 26px;" text="CECAMed"/>
                    </HBox>
                    <Label styleClass="brand-subtitle" text="Sistema de Control y Gestión Médica"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="form-field-label" text="Usuario o Correo"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <TextField fx:id="usernameField" promptText="ej. medico o recepcion" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="form-field-label" text="Contraseña"/>
                    <StackPane alignment="CENTER_RIGHT">
                        <PasswordField fx:id="passwordField" promptText="••••••••"/>
                        <TextField fx:id="passwordVisibleField" managed="false" promptText="••••••••" visible="false"/>
                        <Button fx:id="togglePasswordButton" onAction="#handleTogglePassword" styleClass="ghost-button">
                            <graphic>
                                <FontIcon fx:id="togglePasswordIcon" iconLiteral="feather-eye" iconSize="16"/>
                            </graphic>
                        </Button>
                    </StackPane>
                </VBox>

                <!-- Error Feedback -->
                <Label fx:id="errorLabel" styleClass="error-label" text="Mensaje de error" wrapText="true"/>

                <!-- Login Button & Progress -->
                <StackPane>
                    <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin"
                            styleClass="primary-button" text="Iniciar Sesión">
                        <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="feather-log-in" iconSize="16"/>
                        </graphic>
                    </Button>
                    <ProgressIndicator fx:id="progressIndicator" maxHeight="24.0" maxWidth="24.0" visible="false"/>
                </StackPane>

                <!-- Quick Role Selector for Clinical Demo / Testing -->
                <VBox spacing="8.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 14 0 0 0;">
                    <Label styleClass="form-help-text" text="Acceso rápido por perfil (Demostración):"/>
                    <HBox spacing="10.0">
                        <Button maxWidth="Infinity" onAction="#handleQuickFillMedico" styleClass="ghost-button"
                                text="Rol: Médico" HBox.hgrow="ALWAYS">
                            <graphic>
                                <FontIcon iconLiteral="feather-user-check" iconSize="14"/>
                            </graphic>
                        </Button>
                        <Button maxWidth="Infinity" onAction="#handleQuickFillRecepcion" styleClass="ghost-button"
                                text="Rol: Recepción" HBox.hgrow="ALWAYS">
                            <graphic>
                                <FontIcon iconLiteral="feather-clipboard" iconSize="14"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

            </VBox>

            <Label styleClass="form-help-text" text="CECAMed Clínico v1.0 • Java 21 LTS + AtlantaFX"/>
        </VBox>
    </center>
</BorderPane>
