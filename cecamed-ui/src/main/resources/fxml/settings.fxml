<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="18.0" styleClass="content-pane" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cecamed.ui.controller.SettingsController">

    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
    </fx:define>

    <!-- Header Section -->
    <VBox spacing="4.0">
        <Label styleClass="page-title" text="Configuraci?n del Sistema"/>
        <Label styleClass="page-subtitle" text="Personalizaci?n visual, jornadas de atenci?n m?dica, bloqueos de agenda y diagn?stico"/>
    </VBox>

    <!-- Settings TabPane -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- TAB 1: Apariencia & Temas -->
        <Tab text="Apariencia y Tema">
            <graphic>
                <FontIcon iconLiteral="feather-moon" iconSize="15"/>
            </graphic>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="20.0" style="-fx-padding: 20 10 20 10;">
                    <VBox spacing="16.0" styleClass="cecamed-card">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconColor="#0288D1" iconLiteral="feather-sun" iconSize="18"/>
                            <VBox>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Tema de la Aplicaci?n"/>
                                <Label styleClass="page-subtitle" style="-fx-font-size: 11px;" text="Cambie entre tema claro y oscuro en tiempo real sin reiniciar"/>
                            </VBox>
                        </HBox>
                        <Separator/>

                        <HBox spacing="30.0">
                            <!-- Modo Claro -->
                            <VBox spacing="8.0" style="-fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 14; -fx-pref-width: 260;">
                                <RadioButton fx:id="radioLightMode" style="-fx-font-weight: bold;" text="Modo Claro (Light)" toggleGroup="$themeGroup"/>
                                <Label styleClass="form-help-text" text="Fondo blanco y pizarra claro optimizado para consultorios con luz natural." wrapText="true"/>
                            </VBox>

                            <!-- Modo Oscuro -->
                            <VBox spacing="8.0" style="-fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 14; -fx-pref-width: 260;">
                                <RadioButton fx:id="radioDarkMode" style="-fx-font-weight: bold;" text="Modo Oscuro (Dark)" toggleGroup="$themeGroup"/>
                                <Label styleClass="form-help-text" text="Fondo pizarra oscuro profesional que reduce la fatiga visual nocturna." wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Identidad Visual Card -->
                    <VBox spacing="12.0" styleClass="cecamed-card">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Identidad Visual CECAMed"/>
                        <Separator/>
                        <GridPane hgap="16.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.0"/>
                                <ColumnConstraints percentWidth="33.0"/>
                                <ColumnConstraints percentWidth="33.0"/>
                            </columnConstraints>

                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #FEE2E2; -fx-padding: 10; -fx-background-radius: 6;" GridPane.columnIndex="0">
                                <FontIcon iconColor="#D32F2F" iconLiteral="feather-circle" iconSize="16"/>
                                <VBox>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #991B1B;" text="Rojo Cl?nico"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #B91C1C;" text="?nfasis y acciones principales"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #E0F2FE; -fx-padding: 10; -fx-background-radius: 6;" GridPane.columnIndex="1">
                                <FontIcon iconColor="#0288D1" iconLiteral="feather-circle" iconSize="16"/>
                                <VBox>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #075985;" text="Celeste M?dico"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #0369A1;" text="Informaci?n y selecci?n activa"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #DCFCE7; -fx-padding: 10; -fx-background-radius: 6;" GridPane.columnIndex="2">
                                <FontIcon iconColor="#16A34A" iconLiteral="feather-circle" iconSize="16"/>
                                <VBox>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #166534;" text="Verde Estado"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #15803D;" text="Atenci?n finalizada y ?xito"/>
                                </VBox>
                            </HBox>
                        </GridPane>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- TAB 2: Horarios de Atenci?n M?dica -->
        <Tab text="Horarios de Atenci?n">
            <graphic>
                <FontIcon iconLiteral="feather-clock" iconSize="15"/>
            </graphic>
            <VBox spacing="14.0" style="-fx-padding: 16 0 16 0;">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <FontIcon iconColor="#0288D1" iconLiteral="feather-calendar" iconSize="16"/>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Jornada Laboral y Horarios de Consulta"/>
                </HBox>
                <TableView fx:id="schedulesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDayOfWeek" minWidth="120.0" prefWidth="140.0" text="D?a de la Semana"/>
                        <TableColumn fx:id="colStartTime" minWidth="100.0" prefWidth="120.0" text="Hora de Inicio"/>
                        <TableColumn fx:id="colEndTime" minWidth="100.0" prefWidth="120.0" text="Hora de Cierre"/>
                        <TableColumn fx:id="colDuration" minWidth="120.0" prefWidth="140.0" text="Duraci?n por Cita"/>
                        <TableColumn fx:id="colActive" minWidth="110.0" prefWidth="130.0" text="Estado"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 3: Bloqueos de Agenda M?dica -->
        <Tab text="Bloqueos de Agenda">
            <graphic>
                <FontIcon iconLiteral="feather-slash" iconSize="15"/>
            </graphic>
            <VBox spacing="14.0" style="-fx-padding: 16 0 16 0;">
                <!-- Formulario Nuevo Bloqueo Card -->
                <VBox spacing="12.0" styleClass="cecamed-card">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <FontIcon iconColor="#D32F2F" iconLiteral="feather-plus-circle" iconSize="16"/>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Programar Nuevo Bloqueo de Agenda (Descansos, Vacaciones o Actividades)"/>
                    </HBox>
                    <Separator/>

                    <GridPane hgap="12.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0"/>
                            <ColumnConstraints percentWidth="20.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                        </columnConstraints>

                        <VBox spacing="4.0" GridPane.columnIndex="0">
                            <Label styleClass="form-field-label" text="Motivo o T?tulo *"/>
                            <TextField fx:id="blockTitleField" promptText="ej. Descanso de almuerzo, Congreso..."/>
                        </VBox>

                        <VBox spacing="4.0" GridPane.columnIndex="1">
                            <Label styleClass="form-field-label" text="Tipo de Bloqueo *"/>
                            <ComboBox fx:id="blockTypeComboBox" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="4.0" GridPane.columnIndex="2">
                            <Label styleClass="form-field-label" text="Inicio (Fecha y Hora HH:mm) *"/>
                            <HBox spacing="6.0">
                                <DatePicker fx:id="blockStartDatePicker" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="blockStartTimeField" prefWidth="65.0" promptText="12:00"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4.0" GridPane.columnIndex="3">
                            <Label styleClass="form-field-label" text="Fin (Fecha y Hora HH:mm) *"/>
                            <HBox spacing="6.0">
                                <DatePicker fx:id="blockEndDatePicker" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="blockEndTimeField" prefWidth="65.0" promptText="13:00"/>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <TextField fx:id="blockNotesField" promptText="Notas explicativas del bloqueo (opcional)" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnCreateBlock" onAction="#handleCreateBlock" styleClass="primary-button" text="Guardar Bloqueo">
                            <graphic>
                                <FontIcon iconColor="WHITE" iconLiteral="feather-save" iconSize="15"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Tabla de Bloqueos Activos -->
                <VBox spacing="8.0" styleClass="cecamed-card" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Bloqueos de Agenda Registrados"/>
                    <TableView fx:id="blocksTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colBlockTitle" minWidth="150.0" prefWidth="180.0" text="Motivo"/>
                            <TableColumn fx:id="colBlockType" minWidth="100.0" prefWidth="110.0" text="Tipo"/>
                            <TableColumn fx:id="colBlockStart" minWidth="130.0" prefWidth="140.0" text="Desde"/>
                            <TableColumn fx:id="colBlockEnd" minWidth="130.0" prefWidth="140.0" text="Hasta"/>
                            <TableColumn fx:id="colBlockActions" minWidth="60.0" prefWidth="70.0" sortable="false" text="Acci?n"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>

        <!-- TAB 4: Google Calendar & Diagn?stico del Sistema -->
        <Tab text="Google Calendar &amp; Diagn?stico">
            <graphic>
                <FontIcon iconLiteral="feather-shield" iconSize="15"/>
            </graphic>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="20.0" style="-fx-padding: 20 10 20 10;">
                    <!-- Google Calendar Box -->
                    <VBox spacing="14.0" styleClass="cecamed-card">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconColor="#0288D1" iconLiteral="feather-cloud" iconSize="18"/>
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Sincronizaci?n con Google Calendar API"/>
                        </HBox>
                        <Separator/>
                        <GridPane hgap="16.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30.0"/>
                                <ColumnConstraints percentWidth="70.0"/>
                            </columnConstraints>
                            <Label styleClass="form-help-text" text="ID de Calendario Cl?nico:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="labelGoogleCalendarId" style="-fx-font-weight: bold;" text="primary" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label styleClass="form-help-text" text="Estado del Servicio de Sincronizaci?n:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="labelGoogleSyncStatus" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Info T?cnica del Sistema -->
                    <VBox spacing="14.0" styleClass="cecamed-card">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <FontIcon iconColor="#16A34A" iconLiteral="feather-cpu" iconSize="18"/>
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Informaci?n del Sistema y Entorno"/>
                        </HBox>
                        <Separator/>
                        <GridPane hgap="16.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30.0"/>
                                <ColumnConstraints percentWidth="70.0"/>
                            </columnConstraints>
                            <Label styleClass="form-help-text" text="Plataforma Java:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="labelJavaVersion" style="-fx-font-weight: bold;" text="Java 21 LTS" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label styleClass="form-help-text" text="Framework de Interfaz:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="labelJavaFxVersion" style="-fx-font-weight: bold;" text="JavaFX 21 + AtlantaFX 2.0.1" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label styleClass="form-help-text" text="Framework Empresarial:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="labelSpringVersion" style="-fx-font-weight: bold;" text="Spring Boot 3.3.4" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label styleClass="form-help-text" text="Usuario Autenticado:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="labelCurrentUser" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label styleClass="form-help-text" text="Perfil / Rol Cl?nico:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="labelCurrentRole" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>

</VBox>
